# =============================================================================
# Incus VM provisioning — TRACKED default config.
#
# THIS FILE IS COMMITTED TO GIT. Do NOT put internet-facing or private secrets
# here. VM SSH uses the fixed local-only admin/admin login on the host-private
# Incus bridge and is intentionally not configurable here.
#
# Put private values (private dotfiles URL, resource overrides, etc.) into
# config.env.local — that file is gitignored and is sourced AFTER this one by
# every script, overriding any value defined here.
#
# Pattern:
#   1. Edit this file only for shared defaults (resource sizes, image
#      names, the GIT_REPOS_ROOT path).
#   2. Copy any private value to config.env.local and edit there:
#         echo 'DOTFILES_REPO="git@private-host:dotfiles.git"' >> config.env.local
# =============================================================================

# Your dotfiles git repository URL (override in config.env.local).
# Leave the placeholder here. Optional-dotfiles workloads treat it as
# "no dotfiles"; LaTeX and agent VMs require a real URL before launch.
DOTFILES_REPO="https://github.com/YOUR_USERNAME/dotfiles"

# Command to run inside ~/.dotfiles after cloning.
# GNU Stow: "stow ." stows every package at once.
# Must be a simple one-line command without single quotes or newlines.
DOTFILES_INSTALL_CMD="stow ."

# Optional Tailscale auth key for JupyterHub only.
# Leave empty to keep Jupyter reachable only via its Incus/local IP.
# Put the real key in config.env.local if you want tailnet-only browser access:
#   JUPYTER_TS_AUTHKEY="tskey-auth-..."
JUPYTER_TS_AUTHKEY=""

# Ubuntu source image — full alias on the linuxcontainers.org `images:`
# remote (default in Incus). The `cloud` variant has cloud-init pre-installed,
# which we need. Check available aliases with:
#   incus image alias list images: | grep ubuntu/26.04
UBUNTU_REMOTE="images:ubuntu/26.04/cloud"

# Published image aliases (written to local: remote after each build).
# Ollama VMs are launched directly from BASE_IMAGE and bootstrap Ollama/Docker
# at first boot (no pre-baked Ollama image — keeps image count down).
BASE_IMAGE="local:ubuntu-base"
LATEX_IMAGE="local:ubuntu-latex"
AGENTS_IMAGE="local:ubuntu-agents"

# Incus storage pool for all VM/container roots. build-images.sh also requires
# daemon-wide image tarballs to be redirected to a custom volume on this pool.
INCUS_STORAGE_POOL="vms"

# Resource defaults — adjust to your workload (or override in .local)
LATEX_VM_CPU=4
LATEX_VM_RAM="6GiB"
LATEX_VM_DISK="60GiB"   # texlive-full alone is ~5 GB

AGENT_VM_CPU=4
AGENT_VM_RAM="4GiB"
AGENT_VM_DISK="30GiB"

OLLAMA_VM_CPU=8
OLLAMA_VM_RAM="24GiB"
OLLAMA_VM_DISK="80GiB"  # room for models + OpenWebUI data

JUPYTER_CT_CPU=4
JUPYTER_CT_RAM="8GiB"
JUPYTER_CT_DISK="30GiB"

# Host-side directory holding git repos that get bind-mounted into VMs.
# Bare --git names resolve below this path.
# Change this to your SSD mount, e.g. /mnt/ssd/git or /srv/git.
# Create with: sudo mkdir -p "$GIT_REPOS_ROOT" && sudo chown $USER:$USER "$GIT_REPOS_ROOT"
GIT_REPOS_ROOT="/data/git"
